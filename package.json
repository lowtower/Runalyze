{
  "name": "Runalyze",
  "version": "4.3.0",
  "description": "Runalyze - training analysis for athletes",
  "homepage": "https://runalyze.com/",
  "repository": {
    "type": "git",
    "url": "git://github.com/lowtower/Runalyze"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:styles && npm run build:js && npm run build:vite",

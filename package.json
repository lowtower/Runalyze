    "less": "^4.9.1",
    "vite": "^8.3.5"
  },
  "overrides": {
    "decode-uri-component": "^0.5.1",
    "postcss": "^8.5.32",
    "d3-interpolate": "^3.0.2",
    "d3-color": "^3.1.1"
  }

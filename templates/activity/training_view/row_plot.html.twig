{#
    Plot part of a training view row, replaces TrainingViewSectionRow::displayPlot()
    and TrainingViewSectionRowTabbedPlot::displayPlot().

    Variables (see the row classes' plotTemplateData()):
    - kind: plot | tabbed_plot | table
    - plot: single plot data (see plot.html.twig; null if there is no plot)
    - tabbed_plot: css_id, top_content, tabs (key, html, plot, table)
    - table: template data (an optional 'template' key selects the twig
      template, defaults to table.html.twig, e.g. table_zones.html.twig,
      notes.html.twig or fitdetails.html.twig)
#}
{% if kind == 'tabbed_plot' %}
    <div id="training-view-tabbed-{{ css_id }}" class="training-row-plot">
        {{ top_content|raw }}
        {% for tab in tabs %}
            <div class="change" id="training-view-tabbed-{{ css_id }}-{{ tab.key }}"{% if not loop.first %} style="display:none;"{% endif %}>
                {% if tab.table %}{% include tab.table.template|default('activity/training_view/table.html.twig') with tab.table %}{% elseif tab.plot %}{% include 'activity/training_view/plot.html.twig' with tab.plot %}{% else %}{{ tab.html|raw }}{% endif %}
            </div>
        {% endfor %}
    </div>
{% elseif kind == 'table' %}
    {% include table.template|default('activity/training_view/table.html.twig') with table %}
{% else %}
    <div class="training-row-plot">
        {% if plot %}{% include 'activity/training_view/plot.html.twig' with plot %}{% endif %}
    </div>
{% endif %}

###> symfony/framework-bundle ###
APP_ENV=test
APP_DEBUG=1
###< symfony/framework-bundle ###

###> BASIC PARAMETERS ###
# The install/update controller and smoke tests exercise routes that are
# gated by this flag (the committed default in .env is 'yes').
UPDATE_DISABLED=no
###< BASIC PARAMETERS ###

###> DATABASE CONFIG ###
DATABASE_PREFIX=runalyze_
###< DATABASE CONFIG ###

TEST_TIMEZONE=Europe/Berlin
SQLITE_MOD_SPATIALITE=mod_spatialite.so

# Remove this line to use var/cache/test/test.db again.
TEST_SQLITE_PATH=/dev/shm/runalyze-test.db

# define your env variables for the test env here
KERNEL_CLASS='App\\Kernel'
APP_SECRET='$ecretf0rt3st'

# Route name evaluation must not call the live Overpass API from tests
# (an empty URL makes RouteNameEvalOsm skip the request entirely).
OSM_OVERPASS_URL=

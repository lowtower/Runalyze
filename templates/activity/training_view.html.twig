{#
    Training view for the activity detail page, replaces the display methods of
    inc/training/view/class.TrainingView.php.

    Content-only template: it is included in the shared activity page
    (templates/shared/activity/base.html.twig) and delivered bare for XHR
    requests or wrapped in the page shell for direct requests, see
    LegacyOutputCaptureTrait::wrapLegacyContent().

    The sections are transitional: they are still rendered by the legacy
    section classes and will be ported to twig templates step by step.
#}
<div class="panel-heading">
    <div class="panel-menu">
        <ul>
            {% for link in toolbar_links %}
                {% if link starts with '<li' or link starts with '</' %}
                    {{ link|raw }}
                {% else %}
                    <li>{{ link|raw }}</li>
                {% endif %}
            {% endfor %}
        </ul>
    </div>
    {% if not is_shared %}
        {{ navigation_prev|raw }}{{ navigation_next|raw }}
    {% endif %}
    <h1>{{ title|raw }}</h1>
    {% if not is_shared %}
        <div class="hover-icons"><span class="link" onclick="Runalyze.Statistics.reload();">{{ refresh_icon|raw }}</span></div>
    {% endif %}
</div>
{{ sections_html|raw }}
{{ plots_js|raw }}

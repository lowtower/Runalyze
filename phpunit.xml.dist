<?xml version="1.0" encoding="UTF-8"?>

<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://phpunit.de/phpunit.xsd"
    executionOrder="depends,defects"
    resolveDependencies="true"
    backupGlobals="false"
    backupStaticAttributes="false"
    colors="true"
    bootstrap="./tests/bootstrap.php"
    failOnWarning="false"
    processIsolation="false"
    stopOnError="false"
    stopOnFailure="false"
    verbose="true"
    convertWarningsToExceptions="false"
    beStrictAboutTestsThatDoNotTestAnything="false"
>

    <php>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>

         <server name="KERNEL_DIR" value="./app" />

        <!-- Symfony deprecation handling -->
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="verbose"/>
        <!-- Symfony recommendation -->
        <server name="SYMFONY_PHPUNIT_REMOVE" value=""/>
        <server name="SYMFONY_PHPUNIT_VERSION" value=""/>
    </php>

    <testsuites>
        <testsuite name="RUNALYZE">
            <directory suffix="Test.php">./tests</directory>
        </testsuite>
    </testsuites>

	<filter>
		<whitelist processUncoveredFilesFromWhitelist="false">
		<directory suffix=".php">inc/core</directory>
		<directory suffix=".php">src</directory>
		<exclude>
			<directory>src/*/Tests</directory>
		</exclude>
		</whitelist>
	</filter>

	<logging>
		<log type="junit" target="./var/logs/phpunit-junit.xml"/>
	</logging>

</phpunit>

{% extends 'my/statistics/configuration.html.twig' %}

{% block pluginConfiguration %}
    <form class="ajax no-automatic-reload" action="{{ path('plugin-config', {id: plugin_id}) }}" method="post">
        <input type="hidden" name="edit" value="true">
        <fieldset>
            <legend>{{ 'Configuration'|trans }}</legend>
            {% for key, setting in config_data.settings %}
                <div class="w100 block">
                    <label for="analysis-{{ key }}">{{ setting.label }}</label>
                    {% if setting.default is same as(true) %}
                        <input type="checkbox" id="analysis-{{ key }}" name="{{ key }}" value="1"{% if setting.value %} checked{% endif %}>
                    {% else %}
                        <input type="number" id="analysis-{{ key }}" name="{{ key }}" value="{{ setting.value }}"> {{ setting.unit }}
                    {% endif %}
                </div>
            {% endfor %}
            <div class="w100 block">
                <input type="submit" value="{{ 'Save'|trans }}">
            </div>
        </fieldset>
    </form>
{% endblock %}

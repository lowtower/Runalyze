{
    "name": "runalyze/runalyze",
    "description": "RUNALYZE - training analysis for athletes",
    "homepage": "https://runalyze.com",
    "version": "4.3.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "~8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "beberlei/doctrineextensions": "^1.5",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "egulias/email-validator": "^4.0",
        "guzzlehttp/guzzle": "^8.3",
        "league/geotools": "v2.x-dev",
        "monolog/monolog": "^3.12",
        "p3k/picofeed": "^0.1.40",
        "phpfastcache/phpfastcache": "^9.2",
        "predis/predis": "^3.7",
        "runalyze/age-grade": "v2.2.0",
        "runalyze/common": "v4.3.0",
        "runalyze/dem-reader": "v1.2.0",
        "runalyze/devices": "v0.5.31",
        "runalyze/glossary": "dev-main",
        "runalyze/gpxtrackposter": "dev-runalyze",
        "runalyze/translations": "dev-main",
        "snc/redis-bundle": "^4.13",
        "symfony/asset": "^8.1",
        "symfony/console": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/doctrine-messenger": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/error-handler": "^8.1",
        "symfony/expression-language": "^8.1",
        "symfony/flex": "^2.11",
        "symfony/form": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/mailer": "^8.1",
        "symfony/messenger": "^8.1",
        "symfony/monolog-bundle": "^4.1",
        "symfony/process": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/security-core": "^8.1",
        "symfony/security-http": "^8.1",
        "symfony/translation": "^8.1",
        "symfony/twig-bridge": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/yaml": "^8.1",
        "twig/twig": "^3.30"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "friendsoftwig/twigcs": "^6.6",
        "liip/test-fixtures-bundle": "^3.9",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2.7",
        "rector/swiss-knife": "^2.7",
        "sensiolabs/security-advisories": "dev-master",
        "symfony/browser-kit": "^8.1",
        "symfony/debug-bundle": "^8.1",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/stopwatch": "^8.1",
        "symfony/web-profiler-bundle": "^8.1",
        "symplify/config-transformer": "^12.5",
        "symplify/easy-coding-standard": "^13.3",
        "tomasvotruba/type-coverage": "^2.5",
        "vincentlanglet/twig-cs-fixer": "^4.1"
    },
    "autoload": {
        "files": ["src/functions.php"],
        "classmap": ["inc/", "plugin/"],
        "exclude-from-classmap": ["inc/core/"],
        "psr-4": {
            "App\\": "src/",
            "DoctrineExtensions\\": "vendor/beberlei/DoctrineExtensions/src/",
            "Runalyze\\Bundle\\GlossaryBundle\\": "vendor/runalyze/glossary/",
            "Runalyze\\AgeGrade\\": "vendor/runalyze/age-grade/src/",
            "Runalyze\\Common\\": "vendor/runalyze/common/src/",
            "Runalyze\\DEM\\": "vendor/runalyze/dem-reader/src/",
            "Runalyze\\Devices\\": "vendor/runalyze/devices/src/",
            "Runalyze\\Migrations\\": "migrations/",
            "Runalyze\\Bundle\\": "src/",
            "Runalyze\\": "inc/core/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "Runalyze\\Tests\\": "tests/inc/core/",
            "Runalyze\\Bundle\\CoreBundle\\Tests\\": "tests/CoreBundle"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "runalyze/age-grade",
                "version": "v2.2.0",
                "source": {
                    "url": "https://github.com/lowtower/Runalyze_age-grade.git",
                    "type": "git",
                    "reference": "v2.2.0"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "runalyze/common",
                "version": "v4.3.0",
                "source": {
                    "url": "https://github.com/lowtower/Runalyze_common.git",
                    "type": "git",
                    "reference": "v4.3.0"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "runalyze/dem-reader",
                "version": "v1.2.0",
                "source": {
                    "url": "https://github.com/lowtower/Runalyze_dem-reader.git",
                    "type": "git",
                    "reference": "v1.2.0"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "runalyze/devices",
                "version": "v0.5.31",
                "source": {
                    "url": "https://github.com/lowtower/Runalyze_devices.git",
                    "type": "git",
                    "reference": "v0.5.31"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "runalyze/glossary",
                "version": "dev-main",
                "source": {
                    "url": "https://github.com/lowtower/Runalyze_glossary.git",
                    "type": "git",
                    "reference": "main"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "runalyze/gpxtrackposter",
                "version": "dev-runalyze",
                "source": {
                    "url": "https://github.com/lowtower/GpxTrackPoster.git",
                    "type": "git",
                    "reference": "runalyze"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "runalyze/translations",
                "version": "dev-main",
                "source": {
                    "url": "https://github.com/lowtower/Runalyze_translations.git",
                    "type": "git",
                    "reference": "main"
                }
            }
        }],
    "scripts": {
        "lint": "vendor/bin/ecs check",
        "lint:fix": "vendor/bin/ecs check --fix",
        "rector": "vendor/bin/rector process --dry-run",
        "rector:fix": "vendor/bin/rector process",
        "analyse": [
            "@cache:dev:warmup",
            "vendor/bin/phpstan analyse"
        ],
        "twig:lint": "twigcs templates",
        "fix": [
            "@rector:fix",
            "@lint:fix"
        ],
        "qa": [
            "@rector",
            "@lint",
            "@analyse",
            "@twig:lint"
        ],
        "cache:prod:clear": [
            "mkdir -p var/cache/prod",
            "php bin/console cache:clear --env=prod --no-warmup"
        ],
        "cache:prod:warmup": "php bin/console cache:warmup --env=prod",
        "cache:dev:clear": [
            "mkdir -p var/cache/dev",
            "php bin/console cache:clear --env=dev --no-warmup"
        ],
        "cache:dev:warmup": "php bin/console cache:warmup --env=dev",
        "cache:test:clear": [
            "mkdir -p var/cache/test",
            "php bin/console cache:clear --env=test --no-warmup"
        ],
        "cache:test:warmup": "php bin/console cache:warmup --env=test",
        "cache:test_empty:clear": [
            "mkdir -p var/cache/test_empty",
            "php bin/console cache:clear --env=test_empty --no-warmup"
        ],
        "cache:test_empty:warmup": "php bin/console cache:warmup --env=test_empty",
        "cache:clear":  [
            "@cache:prod:clear",
            "@cache:dev:clear",
            "@cache:test:clear",
            "@cache:test_empty:clear"
        ],
        "cache:warmup": [
            "@cache:prod:warmup",
            "@cache:dev:warmup",
            "@cache:test:warmup",
            "@cache:test_empty:warmup"
        ],
        "test:setup": "bash docker/setup-test-db.sh",
        "test": "XDEBUG_MODE=off php vendor/bin/phpunit -c phpunit.xml.dist --display-warnings",
        "test:dev": "XDEBUG_MODE=off php vendor/bin/phpunit --colors -c phpunit.xml.dist --exclude-group dependsOnSRTM,dependsOnTimezoneDatabase",
        "test:import": "XDEBUG_MODE=off php vendor/bin/phpunit --colors -c phpunit.xml.dist --group import",
        "test:plugin": "XDEBUG_MODE=off php vendor/bin/phpunit --colors -c phpunit.xml.dist --group plugin",
        "test:sqlite": [
            "@cache:test:clear",
            "@test:setup",
            "XDEBUG_MODE=off php vendor/bin/phpunit --colors -c phpunit.xml.dist --group requiresSqlite"
        ],
        "test:doctrine": "XDEBUG_MODE=off php vendor/bin/phpunit --colors -c phpunit.xml.dist --group requiresDoctrine",
        "test:kernel": "XDEBUG_MODE=off php vendor/bin/phpunit --colors -c phpunit.xml.dist --group requiresKernel",
        "test:client": "XDEBUG_MODE=off php vendor/bin/phpunit --colors -c phpunit.xml.dist --group requiresClient",
        "test:default": "XDEBUG_MODE=off php vendor/bin/phpunit --colors -c phpunit.xml.dist --group default,dependsOn,requiresSqlite --exclude-group import,plugin,requiresKernel,requiresDoctrine,requiresClient",
        "test:ci": [
            "@cache:test:clear",
            "@cache:test_empty:clear",
            "@test:setup",
            "@test"
        ],
        "test:verbose": [
            "@cache:test:clear",
            "@cache:test_empty:clear",
            "@test:setup",
            "XDEBUG_MODE=off php vendor/bin/phpunit -c phpunit.xml.dist --display-all"
        ],
        "test:coverage-html": "XDEBUG_MODE=coverage php vendor/bin/phpunit -c phpunit.xml.dist --coverage-html var/coverage",
        "test:coverage-clover": "XDEBUG_MODE=coverage php vendor/bin/phpunit -c phpunit.xml.dist --coverage-clover var/coverage/clover.xml",
        "test:coverage-text": "XDEBUG_MODE=coverage php vendor/bin/phpunit -c phpunit.xml.dist --coverage-text",
        "test:coverage": [
            "@cache:test:clear",
            "@cache:test_empty:clear",
            "@test:setup",
            "@test:coverage-html"
        ],
        "download:tif-testfiles": "bash bin/download-tif-testfiles.sh",
        "download:timezone-databse": "bash bin/download-timezone-sqlite.sh",
        "download:disposable-domains-list": "bash bin/download-disposable-email-domains.sh",
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "config": {
        "process-timeout": 1800,
        "preferred-install": "dist",
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        },
        "phpstan/extension-installer": {
            "ignore": [
                "tomasvotruba/type-coverage"
            ]
        }
    }
}

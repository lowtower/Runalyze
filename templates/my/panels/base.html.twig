<div class="panel-heading">
    <div class="panel-menu">
    {% block panelHeadingMenu %}
    {% endblock %}
    </div>

    <h1 class="link clap" rel="{{ plugin_id }}">{% block pluginTitle %}{% endblock %}</h1>

    <div class="hover-icons">
    {% block panelHeadingIcons -%}
        <a data-size="small" class="window" href="{{ url('plugin-config', {'id': plugin_id}) }}"><i class="fa fa-fw fa-cog"></i></a><span class="link up" rel="{{ plugin_id }}"><i class="fa fa-fw fa-arrow-up"></i></span><span class="link down" rel="{{ plugin_id }}"><i class="fa fa-fw fa-arrow-down"></i></span><span class="link" onclick="Runalyze.reloadPlugin('{{ plugin_id }}');"><i class="fa far fa-fw fa-redo"></i></span>
    {%- endblock %}
    </div>
</div>

<div class="panel-content{% if panel_content_no_padding|default(false) %} nopadding{% endif %}"{% if is_hidden|default(false) %} style="display:none;"{% endif %}>
    {% block panelContent %}
    {% endblock %}
</div>

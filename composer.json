{
    "name": "runalyze/runalyze",
    "description": "RUNALYZE - training analysis for athletes",
    "homepage": "https://runalyze.com",
    "version": "4.3.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "~8.1",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "beberlei/doctrineextensions": "~1.3",
        "doctrine/annotations": "^1.14",
        "doctrine/doctrine-bundle": "^2.7",
        "doctrine/doctrine-migrations-bundle": "^3.2",
        "doctrine/orm": "^2.14",
        "guzzlehttp/guzzle": "^7.0",
        "jms/translation-bundle": "~1.7",
        "league/geotools": "^1.3",
        "monolog/monolog": "^1.26",
        "nojacko/email-validator": "~1.0",
        "p3k/picofeed": "^0.1.40",
        "phpfastcache/phpfastcache": "~8",
        "predis/predis": "^1.0",
        "runalyze/age-grade": "dev-master",
        "runalyze/common": "dev-master",
        "runalyze/dem-reader": "dev-master",
        "runalyze/devices": "dev-master",
        "runalyze/glossary": "v4.3.0",
        "runalyze/gpxtrackposter": "v4.3.0",
        "runalyze/translations": "v4.3.0",
        "snc/redis-bundle": "^4.0",
        "symfony/asset": "~5.4",
        "symfony/console": "~5.4",
        "symfony/css-selector": "~5.4",
        "symfony/dotenv": "~5.4",
        "symfony/flex": "^2.8",
        "symfony/form": "~5.4",
        "symfony/framework-bundle": "^5.4",
        "symfony/mailer": "~5.4",
        "symfony/messenger": "~5.4",
        "symfony/monolog-bundle": "^3.8",
        "symfony/process": "~5.4",
        "symfony/runtime": "5.4.*",
        "symfony/security-bundle": "~5.4",
        "symfony/security-core": "~5.4",
        "symfony/security-guard": "~5.4",
        "symfony/security-http": "~5.4",
        "symfony/translation": "~5.4",
        "symfony/twig-bridge": "5.4.*",
        "symfony/validator": "~5.4",
        "symfony/yaml": "~5.4",
        "twig/extensions": "^1.5",
        "twig/twig": "^2.15"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^3.4",
        "friendsoftwig/twigcs": "^6.1",
        "liip/functional-test-bundle": "~4.16",
        "liip/test-fixtures-bundle": "^3.1.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^10.5",
        "rector/rector": "^2.6",
        "rector/swiss-knife": "^2.4",
        "symfony/browser-kit": "~5.4",
        "symfony/debug-bundle": "~5.4",
        "symfony/maker-bundle": "~1.39",
        "symfony/phpunit-bridge": "^5.4",
        "symfony/stopwatch": "~5.4",
        "symfony/web-profiler-bundle": "~5.4",
        "symplify/config-transformer": "^12.5",
        "symplify/easy-coding-standard": "^13.2",
        "vincentlanglet/twig-cs-fixer": "^0.5.0"
    },
    "autoload": {
        "files": ["src/functions.php"],
        "classmap": ["inc/", "plugin/"],
        "exclude-from-classmap": ["inc/core/"],
        "psr-4": {
            "DoctrineExtensions\\": "vendor/beberlei/DoctrineExtensions/src",
            "App\\": "src/",
            "Runalyze\\": "inc/core/",
            "Runalyze\\Bundle\\": "src/",
            "Runalyze\\Bundle\\GlossaryBundle\\": "vendor/runalyze/glossary"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "Runalyze\\Tests\\": "tests/inc/core/",
            "Runalyze\\Bundle\\CoreBundle\\Tests\\": "tests/CoreBundle"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "runalyze/gpxtrackposter",
                "version": "v4.3.0",
                "source": {
                    "url": "https://github.com/lowtower/GpxTrackPoster.git",
                    "type": "git",
                    "reference": "runalyze"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "runalyze/glossary",
                "version": "v4.3.0",
                "source": {
                    "url": "https://github.com/lowtower/Runalyze-Glossary.git",
                    "type": "git",
                    "reference": "v4.3.0"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "runalyze/translations",
                "version": "v4.3.0",
                "source": {
                    "url": "https://github.com/lowtower/Runalyze-Translations.git",
                    "type": "git",
                    "reference": "master"
                }
            }
        }],
    "scripts": {
        "lint": "vendor/bin/ecs check",
        "lint:fix": "vendor/bin/ecs check --fix",
        "rector": "vendor/bin/rector process --dry-run",
        "rector:fix": "vendor/bin/rector process",
        "analyse": [
            "@cache:dev:warmup",
            "vendor/bin/phpstan analyse"
        ],
        "twig:lint": "twigcs templates",
        "fix": [
            "@rector:fix",
            "@lint:fix"
        ],
        "qa": [
            "@rector",
            "@lint",
            "@analyse",
            "@twig:lint"
        ],
        "cache:prod:clear": "php bin/console cache:clear --env=prod --no-warmup",
        "cache:prod:warmup": "php bin/console cache:warmup --env=prod",
        "cache:dev:clear": "php bin/console cache:clear --env=dev --no-warmup",
        "cache:dev:warmup": "php bin/console cache:warmup --env=dev",
        "cache:test:clear": "php bin/console cache:clear --env=test --no-warmup",
        "cache:test:warmup": "php bin/console cache:warmup --env=test",
        "cache:test_empty:clear": "php bin/console cache:clear --env=test_empty --no-warmup",
        "cache:test_empty:warmup": "php bin/console cache:warmup --env=test_empty",
        "cache:clear":  [
            "@cache:prod:clear",
            "@cache:dev:clear",
            "@cache:test:clear",
            "@cache:test_empty:clear"
        ],
        "cache:warmup": [
            "@cache:prod:warmup",
            "@cache:dev:warmup",
            "@cache:test:warmup",
            "@cache:test_empty:warmup"
        ],
        "test:setup": "bash docker/setup-test-db.sh",
        "test": "php vendor/bin/phpunit -c phpunit.xml.dist",
        "test:dev": "php vendor/bin/phpunit --colors -c phpunit.xml.dist --exclude-group dependsOnSRTM,dependsOnTimezoneDatabase",
        "test:import": "php vendor/bin/phpunit --colors -c phpunit.xml.dist --group import",
        "test:plugin": "php vendor/bin/phpunit --colors -c phpunit.xml.dist --group plugin",
        "test:sqlite": [
            "@cache:test:clear",
            "@test:setup",
            "php vendor/bin/phpunit --colors -c phpunit.xml.dist --group requiresSqlite"
        ],
        "test:doctrine": "php vendor/bin/phpunit --colors -c phpunit.xml.dist --group requiresDoctrine",
        "test:kernel": "php vendor/bin/phpunit --colors -c phpunit.xml.dist --group requiresKernel",
        "test:client": "php vendor/bin/phpunit --colors -c phpunit.xml.dist --group requiresClient",
        "test:default": "php vendor/bin/phpunit --colors -c phpunit.xml.dist --group default,dependsOn,requiresSqlite --exclude-group import,plugin,requiresKernel,requiresDoctrine,requiresClient",
        "test:ci": [
            "@cache:test:clear",
            "@cache:test_empty:clear",
            "@test:setup",
            "@test"
        ],
        "test:coverage-html": "XDEBUG_MODE=coverage php vendor/bin/phpunit -c phpunit.xml.dist --coverage-html var/coverage",
        "test:coverage-clover": "XDEBUG_MODE=coverage php vendor/bin/phpunit -c phpunit.xml.dist --coverage-clover var/coverage/clover.xml",
        "test:coverage-text": "XDEBUG_MODE=coverage php vendor/bin/phpunit -c phpunit.xml.dist --coverage-text",
        "test:coverage": [
            "@cache:test:clear",
            "@cache:test_empty:clear",
            "@test:setup",
            "@test:coverage-html"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "config": {
        "process-timeout": 1800,
        "preferred-install": "dist",
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "5.4.*"
        }
    }
}

{% extends 'my/statistics/base.html.twig' %}

{% macro cityLink(city) %}
    <a class="window" data-size="big" href="{{ path('my-search', {get: 'true', route: city, opt: {route: 'like'}}) }}">{{ city }}</a>
{% endmacro %}

{% block pluginTitle %}{{ title }}{% endblock %}

{% block panelHeadingMenu %}
    <ul>
        <li><a class="window" data-size="big" href="{{ path('statistics-route-network', {sport: filter.sport, y: filter.year}) }}"><i class="fa fa-map-marker"></i> {{ 'Open route network'|trans }}</a></li>
    </ul>
    {% include 'my/statistics/_sport_and_year_menu.html.twig' with {pluginId: pluginId, filter: filter, yearLabel: yearLabel} only %}
{% endblock %}

{% block panelContent %}
    <table class="zebra-style {{ showCities ? 'left' : 'fullwidth' }}"{% if showCities %} style="width:70%"{% endif %}>
        <thead><tr><th colspan="3">{{ 'Most frequent routes'|trans }}</th></tr></thead>
        <tbody class="r">
            {% for route in routes %}
                <tr>
                    <td>{{ route.count }}x</td>
                    <td class="l">
                        <a class="window" data-size="big" href="{{ path('my-search', {get: 'true', route: route.name}) }}" title="{{ route.name }}">{{ route.name|length >= 100 ? route.name|slice(0, 97) ~ '...' : route.name }}</a>
                    </td>
                    <td>{{ distance(route.distance).getWithUnit|raw }}</td>
                </tr>
            {% else %}
                <tr><td colspan="3" class="c"><em>{{ 'There are no routes.'|trans }}</em></td></tr>
            {% endfor %}
        </tbody>
    </table>
    {% if showCities %}
        <table class="right zebra-style" style="width:25%">
            <thead><tr><th colspan="2">{{ 'Most frequent places'|trans }}</th></tr></thead>
            <tbody>
                {% for city, count in frequentCities %}
                    <tr><td>{{ count }}x</td><td>{{ _self.cityLink(city) }}</td></tr>
                {% else %}
                    <tr><td colspan="2"><em>{{ 'There are no routes.'|trans }}</em></td></tr>
                {% endfor %}
            </tbody>
        </table>
        <br class="clear">
        <br class="clear">
        <table class="margin-5 fullwidth zebra-style">
            <thead><tr><th colspan="2">{{ 'Rare places'|trans }}</th></tr></thead>
            <tbody>
                {% for count, cities in rareCities %}
                    <tr>
                        <td class="b">{{ count }}x</td>
                        <td>
                            {%- for city in cities -%}
                                {{ _self.cityLink(city) }}{{ not loop.last ? ', ' : '' }}
                            {%- endfor -%}
                        </td>
                    </tr>
                {% endfor %}
                <tr class="no-zebra"><td colspan="2" class="c">{{ 'You have visited %s different places.'|trans|format(cityCount) }}</td></tr>
            </tbody>
        </table>
        <p class="c"><em>{{ "Everything seperated by a ' - ' is considered as an individual place."|trans }}</em></p>
    {% endif %}
{% endblock %}

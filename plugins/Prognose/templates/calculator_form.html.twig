<div class="panel-heading">
    <h1>{{ 'Prognosis calculator'|trans }}</h1>
</div>
<div class="panel-content">
    <form id="prognosis-calculator" class="ajax no-automatic-reload" action="{{ path('prognosis-calculator-window') }}" method="post">
        <fieldset>
            <legend>{{ 'Input'|trans }}</legend>
            <div class="w50 marginr50">
                <label for="prognosis-model">{{ 'Model'|trans }}</label>
                <select name="model" id="prognosis-model">
                    <option value="vo2max"{% if input.model == 'vo2max' %} selected{% endif %}>Effective VO2max</option>
                    <option value="robert-bock"{% if input.model == 'robert-bock' %} selected{% endif %}>Robert Bock (CPP)</option>
                    <option value="herbert-steffny"{% if input.model == 'herbert-steffny' %} selected{% endif %}>Herbert Steffny</option>
                    <option value="david-cameron"{% if input.model == 'david-cameron' %} selected{% endif %}>David Cameron</option>
                </select>
            </div>
            <div class="w50 marginr50">
                <label for="prognosis-distances">{{ 'Distances'|trans }}</label>
                <span class="input-with-unit">
                    <input type="text" class="full-size" id="prognosis-distances" name="distances" value="{{ input.distances }}">
                    <label for="prognosis-distances" class="input-unit">{{ distance_unit }}</label>
                </span>
            </div>
            <div class="w50 hide-on-model-change only-vo2max">
                <label for="prognosis-vo2max">{{ 'Effective VO2max'|trans }}</label>
                <input type="text" class="small-size" id="prognosis-vo2max" name="vo2max" value="{{ input.vo2max|default('') }}">
            </div>
            <div class="w50 hide-on-model-change only-vo2max">
                <label for="prognosis-endurance-value">{{ 'Marathon Shape'|trans }}</label>
                <span class="input-with-unit">
                    <input type="text" class="small-size" id="prognosis-endurance-value" name="endurance-value" value="{{ input['endurance-value']|default('') }}">
                    <label for="prognosis-endurance-value" class="input-unit">%</label>
                </span>
            </div>
            <div class="w50 hide-on-model-change only-vo2max">
                <label for="prognosis-endurance" class="checkable">{{ 'Use Marathon Shape'|trans }}</label>
                <input type="checkbox" id="prognosis-endurance" name="endurance" value="1"{% if input.endurance is defined and input.endurance %} checked{% endif %}>
            </div>
            <div class="w50 hide-on-model-change only-robert-bock only-herbert-steffny only-david-cameron">
                <label for="prognosis-best-result">{{ 'Best result'|trans }}</label>
                <span class="input-with-unit">
                    <input type="text" class="small-size" id="prognosis-best-result" name="best-result-km" value="{{ input['best-result-km'] }}">
                    <label for="prognosis-best-result" class="input-unit">{{ distance_unit }}</label>
                </span>
            </div>
            <div class="w50 hide-on-model-change only-robert-bock only-herbert-steffny only-david-cameron">
                <label for="prognosis-best-time">{{ 'in'|trans }}</label>
                <input type="text" class="small-size" id="prognosis-best-time" name="best-result-time" value="{{ input['best-result-time'] }}">
            </div>
            <div class="w50 hide-on-model-change only-robert-bock">
                <label for="prognosis-second-result">{{ 'Second best result'|trans }}</label>
                <span class="input-with-unit">
                    <input type="text" class="small-size" id="prognosis-second-result" name="second-best-result-km" value="{{ input['second-best-result-km'] }}">
                    <label for="prognosis-second-result" class="input-unit">{{ distance_unit }}</label>
                </span>
            </div>
            <div class="w50 hide-on-model-change only-robert-bock">
                <label for="prognosis-second-time">{{ 'in'|trans }}</label>
                <input type="text" class="small-size" id="prognosis-second-time" name="second-best-result-time" value="{{ input['second-best-result-time'] }}">
            </div>
            <div class="fieldset-messages">
                {% for info in info_lines %}
                    <p class="info">{{ info|raw }}</p>
                {% endfor %}
            </div>
        </fieldset>
        <fieldset>
            <legend>{{ 'Prognosis'|trans }}</legend>
            <div class="fieldset-messages">
                <div>{{ result_table|raw }}</div>
            </div>
        </fieldset>
        <input type="submit" name="submit" value="{{ 'Show prognosis'|trans }}">
    </form>
</div>

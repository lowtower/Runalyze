{
    "name": "runalyze/runalyze",
    "description": "RUNALYZE - training analysis for athletes",
    "homepage": "https://runalyze.com",
    "version": "4.3.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "~7",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "beberlei/doctrineextensions": "~1.3",
        "doctrine/annotations": "^1.14",
        "doctrine/doctrine-bundle": "^2.3",
        "doctrine/doctrine-migrations-bundle": "^2.2",
        "doctrine/orm": "^2.7",
        "guzzlehttp/guzzle": "^7.0",
        "jms/translation-bundle": "~1.7",
        "laminas/laminas-zendframework-bridge": "^1.6",
        "league/geotools": "^0.8.3",
        "monolog/monolog": "^1.26",
        "nojacko/email-validator": "~1.0",
        "p3k/picofeed": "^0.1.40",
        "phpfastcache/phpfastcache": "~8",
        "predis/predis": "^1.0",
        "runalyze/age-grade": "^1.2",
        "runalyze/common": "v4.3.0",
        "runalyze/dem-reader": "^1.1",
        "runalyze/devices": "v4.3.0",
        "runalyze/glossary": "v4.3.0",
        "runalyze/gpxtrackposter": "^1.0.0",
        "runalyze/translations": "dev-master",
        "sensio/framework-extra-bundle": "~5.4",
        "snc/redis-bundle": "^3.6",
        "symfony/asset": "^4.4",
        "symfony/console": "4.4.*",
        "symfony/css-selector": "4.4.*",
        "symfony/dotenv": "4.4.*",
        "symfony/flex": "^1.22",
        "symfony/form": "^4.4",
        "symfony/framework-bundle": "4.4.*",
        "symfony/mailer": "^4.4",
        "symfony/messenger": "4.4.*",
        "symfony/monolog-bundle": "^3.8",
        "symfony/process": "^4.4",
        "symfony/security-bundle": "^4.4",
        "symfony/translation": "^4.4",
        "symfony/validator": "^4.4",
        "symfony/yaml": "4.4.*",
        "twig/extensions": "^1.5",
        "twig/twig": "~1.44"
    },
    "autoload": {
        "files": ["src/functions.php"],
        "classmap": ["inc/", "plugin/"],
        "exclude-from-classmap": ["inc/core/"],
        "psr-4": {
            "DoctrineExtensions\\": "vendor/beberlei/DoctrineExtensions/src",
            "App\\": "src/",
            "Runalyze\\": "inc/core/",
            "Runalyze\\Bundle\\": "src/",
            "Runalyze\\Bundle\\GlossaryBundle\\": "vendor/runalyze/glossary"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "Runalyze\\Tests\\": "tests/inc/core/",
            "Runalyze\\Bundle\\CoreBundle\\Tests\\": "tests/CoreBundle"
        }
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^3.4",
        "liip/functional-test-bundle": "^4.3.0",
        "liip/test-fixtures-bundle": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^8.5",
        "rector/rector": "^2.6",
        "rector/swiss-knife": "^2.4",
        "symfony/debug-bundle": "4.4.*",
        "symfony/maker-bundle": "^1.39",
        "symfony/stopwatch": "^4.4",
        "symfony/web-profiler-bundle": "^4.4",
        "symplify/config-transformer": "^12.5",
        "symplify/easy-coding-standard": "^13.2"
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "runalyze/gpxtrackposter",
                "version": "1.0.0",
                "source": {
                    "url": "https://github.com/lowtower/GpxTrackPoster.git",
                    "type": "git",
                    "reference": "runalyze"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "runalyze/glossary",
                "version": "v4.3.0",
                "source": {
                    "url": "https://github.com/lowtower/Runalyze-Glossary.git",
                    "type": "git",
                    "reference": "v4.3.0"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "runalyze/common",
                "version": "v4.3.0",
                "source": {
                    "url": "https://github.com/Runalyze/common.git",
                    "type": "git",
                    "reference": "b5d14283b809b9e039c7d73ad7b1a3b3da00757c"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "runalyze/devices",
                "version": "v4.3.0",
                "source": {
                    "url": "https://github.com/Runalyze/devices.git",
                    "type": "git",
                    "reference": "e00bdfe2b69285f0870394810cc5b26138c8ca19"
                }
            }
        }],
    "scripts": {
        "lint": "vendor/bin/ecs check",
        "lint:fix": "vendor/bin/ecs check --fix",
        "rector": "vendor/bin/rector process --dry-run",
        "rector:fix": "vendor/bin/rector process",
        "analyse": "vendor/bin/phpstan analyse",
        "fix": [
            "@rector:fix",
            "@lint:fix"
        ],
        "qa": [
            "@rector",
            "@lint",
            "@analyse"
        ],
        "cache:prod:clear": "php bin/console cache:clear --env=prod --no-warmup",
        "cache:prod:warmup": "php bin/console cache:warmup --env=prod",
        "cache:dev:clear": "php bin/console cache:clear --env=dev --no-warmup",
        "cache:dev:warmup": "php bin/console cache:warmup --env=dev",
        "cache:test:clear": "php bin/console cache:clear --env=test --no-warmup",
        "cache:test:warmup": "php bin/console cache:warmup --env=test",
        "cache:clear":  [
            "@cache:prod:clear",
            "@cache:dev:clear",
            "@cache:test:clear"
        ],
        "cache:warmup": [
            "@cache:prod:warmup",
            "@cache:dev:warmup",
            "@cache:test:warmup"
        ],
        "test:setup": "bash docker/setup-test-db.sh",
        "test": "php vendor/bin/phpunit -c phpunit.xml.dist",
        "test:dev": "php vendor/bin/phpunit --colors -c phpunit.xml.dist --exclude-group dependsOnSRTM,dependsOnTimezoneDatabase",
        "test:import": "php vendor/bin/phpunit --colors -c phpunit.xml.dist --group import",
        "test:doctrine": "php vendor/bin/phpunit --colors -c phpunit.xml.dist --group requiresDoctrine",
        "test:kernel": "php vendor/bin/phpunit --colors -c phpunit.xml.dist --group requiresKernel",
        "test:client": "php vendor/bin/phpunit --colors -c phpunit.xml.dist --group requiresClient",
        "test:default": "php vendor/bin/phpunit --colors -c phpunit.xml.dist --group default,dependsOn,requiresSqlite --exclude-group import,requiresKernel,requiresDoctrine,requiresClient",
        "test:ci": [
            "@cache:test:clear",
            "@test:setup",
            "@test"
        ],
        "test:coverage-html": "php vendor/bin/phpunit -c phpunit.xml.dist --coverage-html var/coverage",
        "test:coverage-clover": "php vendor/bin/phpunit -c phpunit.xml.dist --coverage-clover var/log/clover.xml",
        "test:coverage-text": "php vendor/bin/phpunit -c phpunit.xml.dist --coverage-text",
        "test:coverage": [
            "@test:coverage-html",
            "@test:coverage-clover"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "config": {
        "process-timeout": 1800,
        "preferred-install": "dist",
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true
        },
        "sort-packages": true
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "4.4.*"
        }
    }
}

{% extends "base_logged_in.twig" %}

{#
    Full-page shell for content that is still generated by legacy PHP
    (included legacy scripts and legacy view classes). XHR requests never
    use this template: they receive the bare content, see
    LegacyOutputCaptureTrait::wrapLegacyContent().
#}
{% block content %}
    {% if is_granted('IS_IMPERSONATOR') %}
        <div style="margin: 10px 0 0 10px;">
            <a href="{{ path('dashboard', {'_switch_user': '_exit'}) }}" style="display: inline-block; padding: 5px 10px; background-color: #c9302c; color: #ffffff; border-radius: 3px; font-weight: bold; text-decoration: none;">
                <i class="fa fa-fw fa-sign-out-alt"></i>&nbsp;{% trans %}Exit impersonation{% endtrans %}
            </a>
        </div>
    {% endif %}

    {{ legacyContent|raw }}
{% endblock %}

{% extends 'my/statistics/configuration.html.twig' %}

{% block pluginConfiguration %}
    <form class="ajax no-automatic-reload" action="{{ path('plugin-config', {id: plugin_id}) }}" method="post">
        <input type="hidden" name="edit" value="true">
        <fieldset>
            <legend>{{ 'Configuration'|trans }}</legend>
            <div class="w100 block">
                <label for="summary-compare-weeks">
                    <input id="summary-compare-weeks" type="checkbox" name="compare_weeks" value="1"{% if config_data.compareWeeks %} checked{% endif %}>
                    {{ 'Compare kilometers per week'|trans }}
                </label>
            </div>
            <div class="w100 block">
                <label for="summary-show-streak">
                    <input id="summary-show-streak" type="checkbox" name="show_streak" value="1"{% if config_data.showStreak %} checked{% endif %}>
                    {{ 'Show streak'|trans }}
                </label>
            </div>
            <div class="w100 block">
                <label for="summary-minimum-days">{{ 'Minimum number of days to show a streak (0 for always)'|trans }}</label>
                <input id="summary-minimum-days" type="number" min="0" name="show_streak_days" value="{{ config_data.minimumDays }}">
            </div>
            <div class="w100 block">
                <input type="submit" value="{{ 'Save'|trans }}">
            </div>
        </fieldset>
    </form>
{% endblock %}

{#-
    A table of the training view, replaces the code string building of
    inc/training/view/section/table/*.php

    Variables (see the table classes' templateData()):
    - class: css class of the table
    - wrapper_style: optional enclosing div style
    - warning: raw html shown after the table
    - header: cells (content/class/style/italic)
    - bodies: row groups, each row has class, style and cells (content/class/style/colspan/italic)
-#}
{% if wrapper_style %}<div style="{{ wrapper_style }}">{% endif %}<table class="{{ class }}"><thead><tr>{% for cell in header %}<th{% set cellClass = cell.class ?? 'r' %}{% if cellClass %} class="{{ cellClass }}"{% endif %}{% if cell.style %} style="{{ cell.style }}"{% endif %}>{% if cell.italic %}<i>{% endif %}{{ cell.content|raw }}{% if cell.italic %}</i>{% endif %}</th>{% endfor %}</tr></thead>{% for body in bodies %}<tbody>{% for row in body.rows %}<tr{% set rowClass = row.class ?? 'r' %}{% if rowClass %} class="{{ rowClass }}"{% endif %}{% if row.style %} style="{{ row.style }}"{% endif %}>{% for cell in row.cells %}<td{% if cell.colspan %} colspan="{{ cell.colspan }}"{% endif %}{% if cell.style %} style="{{ cell.style }}"{% endif %}{% if cell.class %} class="{{ cell.class }}"{% endif %}>{% if cell.italic %}<i>{% endif %}{{ cell.content|raw }}{% if cell.italic %}</i>{% endif %}</td>{% endfor %}</tr>{% endfor %}</tbody>{% endfor %}</table>{% if warning %}{{ warning|raw }}{% endif %}{% if wrapper_style %}</div>{% endif %}

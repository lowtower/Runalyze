{% extends "base_logged_in.twig" %}

{% block content %}
    {% if showForm %}
        <div class="panel-heading">
            <h1>{% trans %}Search for activities{% endtrans %}</h1>
        </div>

        <div class="panel-content">
            <form action="{{ url('my-search') }}" method="post" id="search" class="ajax">
                <input type="hidden" name="page" value="1">

                <fieldset id="search_legend_0">
                    <legend onclick="Runalyze.toggleFieldset(this, 'search_legend_0', false, '')">{% trans %}Search activities{% endtrans %}</legend>

                    {% for field in fields %}
                        {% if field.kind == 'multiselect' %}
                            <div class="{{ field.layout }}">
                                <label for="{{ field.name }}">{{ field.label|raw }}</label>
                                <select name="{{ field.name }}[]" id="{{ field.name }}" class="chosen-select full-size" multiple="multiple" data-placeholder="{{ field.placeholder }}">
                                    {% for value, label in field.options %}
                                        <option value="{{ value }}"{% if value in field.selected %} selected{% endif %}>{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% elseif field.kind == 'time_range' %}
                            <div class="{{ field.layout }}">
                                <label>{{ field.label|raw }}</label>
                                <div class="full-size left">
                                    <span class="input-with-unit"><input type="text" name="date-from" id="date-from" value="{{ field.from }}" class="pick-a-date small-size"><label for="date-from" class="input-unit"><i class="fa far fa-fw fa-calendar"></i></label></span>
                                    {% trans %}to{% endtrans %}
                                    <span class="input-with-unit"><input type="text" name="date-to" id="date-to" value="{{ field.to }}" class="pick-a-date small-size"><label for="date-to" class="input-unit"><i class="fa far fa-fw fa-calendar"></i></label></span>
                                </div>
                            </div>
                        {% elseif field.kind == 'sort' %}
                            <div class="{{ field.layout }}">
                                <label>{{ field.label|raw }}</label>
                                <div class="full-size left">
                                    <select name="search-sort-by">
                                        {% for value, label in field.byOptions %}
                                            <option value="{{ value }}"{% if field.bySelected is not null and value == field.bySelected %} selected{% endif %}>{{ label }}</option>
                                        {% endfor %}
                                    </select>
                                    <select name="search-sort-order">
                                        {% for value, label in field.orderOptions %}
                                            <option value="{{ value }}"{% if field.orderSelected is not null and value == field.orderSelected %} selected{% endif %}>{{ label }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                        {% elseif field.kind == 'input' %}
                            <div class="{{ field.layout }}">
                                <label for="{{ field.name }}">{{ field.label|raw }}</label>
                                <input type="text" name="{{ field.name }}" id="{{ field.name }}" value="{{ field.value }}" class="{{ field.size }}">
                                {% if field.hiddenOperator %}
                                    <input type="hidden" name="opt[{{ field.name }}]" id="opt[{{ field.name }}]" value="{{ field.hiddenOperator }}">
                                {% endif %}
                            </div>
                        {% elseif field.kind == 'condition' %}
                            <div class="{{ field.layout }}">
                                <label>{{ field.label|raw }}</label>
                                <select name="opt[{{ field.name }}]">
                                    {% for value, label in field.operators %}
                                        <option value="{{ value }}"{% if field.operator == value %} selected{% endif %}>{{ label }}</option>
                                    {% endfor %}
                                </select>
                                {% if field.unit %}
                                    <span class="input-with-unit"><input type="text" name="{{ field.name }}" id="{{ field.name }}" value="{{ field.value }}" class="{{ field.size }}"{% if field.placeholder %} placeholder="{{ field.placeholder }}"{% endif %}><label for="{{ field.name }}" class="input-unit">{{ field.unit }}</label></span>
                                {% else %}
                                    <input type="text" name="{{ field.name }}" id="{{ field.name }}" value="{{ field.value }}" class="{{ field.size }}"{% if field.placeholder %} placeholder="{{ field.placeholder }}"{% endif %}>
                                {% endif %}
                            </div>
                        {% elseif field.kind == 'select' %}
                            <div class="{{ field.layout }}">
                                <label for="{{ field.name }}">{{ field.label|raw }}</label>
                                <select name="{{ field.name }}" id="{{ field.name }}">
                                    {% for value, label in field.options %}
                                        {% set is_selected = false %}
                                        {% if field.selected is not null and field.selected == '' and value == '' %}
                                            {% set is_selected = true %}
                                        {% elseif field.selected is not null and field.selected != '' and value == field.selected %}
                                            {% set is_selected = true %}
                                        {% endif %}
                                        <option value="{{ value }}"{% if is_selected %} selected{% endif %}>{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% elseif field.kind == 'checkbox' %}
                            <div class="{{ field.layout }}">
                                <label class="checkable" for="{{ field.name }}">{{ field.label|raw }}</label>
                                <input type="checkbox" name="{{ field.name }}" id="{{ field.name }}"{% if field.checked %} checked="checked"{% endif %}>
                            </div>
                        {% elseif field.kind == 'submit' %}
                            <div class="{{ field.layout }}">
                                <input type="submit" value="{{ field.value }}">
                            </div>
                        {% endif %}
                    {% endfor %}
                </fieldset>

                <div class="c"></div>
            </form>
        </div>
    {% endif %}

    {{ resultsHtml|raw }}
{% endblock %}

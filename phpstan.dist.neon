includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    phpVersion: 80134
    reportUnmatchedIgnoredErrors: true
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml

    bootstrapFiles:
        - vendor/autoload.php
        - inc/class.Helper.php
        - inc/system/define.consts.php
        - phpstan-bootstrap-constants.php

    paths:
#        - dashboard.php
        - bin/
        - config/
        - inc/
        - lib/
        - plugin/
        - public/
        - src/
#        - tests/

    doctrine:
        repositoryClass: null

    treatPhpDocTypesAsCertain: false

    type_coverage:
        return: 5
        param: 5
        property: 5
        # enable on PHP 8.3+
        # constant: 5

